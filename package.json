{
  "name": "drift-diffusion-simulator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24"
  },
  "description": "Validated browser laboratories for self-consistent PN and 2D lateral NPN devices.",
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/self-check.mjs && node scripts/bjt-self-check.mjs && node scripts/bjt-wasm-self-check.mjs",
    "build:wasm": "powershell -ExecutionPolicy Bypass -File scripts/build-wasm.ps1",
    "build:bjt-wasm": "powershell -ExecutionPolicy Bypass -File scripts/build-wasm.ps1 -SourcePath native/bjt-core/bjt-core.c -WasmPath assets/wasm/bjt-core.wasm -ExportNames npn_solve,npn_array_count,npn_diagnostic_count -UseLibm",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@carbon/react": "1.113.0",
    "@ibm/plex": "6.4.1",
    "@jorpago2/scientific-ui": "file:vendor\\jorpago2-scientific-ui-0.6.0.tgz",
    "plotly.js-cartesian-dist-min": "3.7.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@storybook/react-vite": "^10.5.7",
    "@types/plotly.js": "^3.0.10",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "playwright": "1.62.1",
    "sass": "1.102.0",
    "storybook": "^10.5.7",
    "typescript": "6.0.2",
    "vite": "8.2.0"
  }
}
